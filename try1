###################Simple Rule-Based Chatbot
chatbot_response <- function(input) {
  input <- tolower(input)

  if (grepl("hello|hi|hey", input)) {
    return("Hello! How can I help you today?")
  } 
  else if (grepl("your name", input)) {
    return("I am a simple R chatbot 🤖")
  } 
  else if (grepl("help", input)) {
    return("You can ask me about greetings, my name, or type 'bye' to exit.")
  } 
  else if (grepl("bye|exit|quit", input)) {
    return("Goodbye! Have a nice day 👋")
  } 
  else {
    return("Sorry, I don't understand that yet.")
  }
}

# Start chatbot loop
cat("Chatbot: Hello! Type something (type 'bye' to stop)\n")

repeat {
  user_input <- readline("You: ")
  response <- chatbot_response(user_input)
  cat("Bot:", response, "\n")

  if (tolower(user_input) %in% c("bye", "exit", "quit")) {
    break
  }
}

