install.packages("tm")
install.packages("text2vec")
install.packages("dplyr")
install.packages("stringr")

library(tm)
library(text2vec)
library(dplyr)
library(stringr)

##DATA 
docs <- data.frame(
  doc_id = 1:5,
  text = c(
    "R is a programming language used for statistics and data analysis.",
    "Python is widely used in machine learning and artificial intelligence.",
    "R supports packages like ggplot2 for data visualization.",
    "Machine learning involves training models on data to make predictions.",
    "Data science combines statistics, programming, and domain knowledge."
  ),
  stringsAsFactors = FALSE
)

docs

#Text Preprocessing
corpus <- VCorpus(VectorSource(docs$text))

corpus <- corpus %>%
  tm_map(content_transformer(tolower)) %>%
  tm_map(removePunctuation) %>%
  tm_map(removeNumbers) %>%
  tm_map(removeWords, stopwords("en")) %>%
  tm_map(stripWhitespace)

##Convert Text → TF-IDF Matrix (Embeddings)
dtm <- DocumentTermMatrix(corpus)

tfidf <- weightTfIdf(dtm)
matrix <- as.matrix(tfidf)
##we have vector representations of documents.

#Define Query Function (RAG Retrieval Step: We convert the query into the same vector space and compute similarity.
cosine_similarity <- function(a, b) {
  sum(a * b) / (sqrt(sum(a * a)) * sqrt(sum(b * b)))
}

#RAG Retrieval Function
retrieve_docs <- function(query, matrix, docs, top_k = 2) {
  
  # preprocess query
  query_corpus <- VCorpus(VectorSource(query)) %>%
    tm_map(content_transformer(tolower)) %>%
    tm_map(removePunctuation) %>%
    tm_map(removeNumbers) %>%
    tm_map(removeWords, stopwords("en")) %>%
    tm_map(stripWhitespace)
  
  query_dtm <- DocumentTermMatrix(query_corpus, control = list(dictionary = Terms(dtm)))
  query_vec <- as.matrix(query_dtm)
  
  # compute similarity
  scores <- apply(matrix, 1, function(x) cosine_similarity(x, query_vec))
  
  # rank results
  top_idx <- order(scores, decreasing = TRUE)[1:top_k]
  
  return(docs[top_idx, ])
}

#Ask a Question (RAG Query)
question <- "What is machine learning used for?"

retrieved_docs <- retrieve_docs(question, matrix, docs, top_k = 2)

retrieved_docs

#Generation Step (Mock LLM Answer)

generate_answer <- function(question, retrieved_docs) {
  
  context <- paste(retrieved_docs$text, collapse = " ")
  
  answer <- paste0(
    "Question: ", question, "\n\n",
    "Retrieved Context: ", context, "\n\n",
    "Final Answer: ",
    "Based on the retrieved information, machine learning is used for training models on data to make predictions and is widely applied in AI systems."
  )
  
  return(answer)
}

#Run Full RAG Pipeline
final_output <- generate_answer(question, retrieved_docs)

cat(final_output)

