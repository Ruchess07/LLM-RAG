install.packages("nnet")

# Load library
library(nnet)

# Load dataset
data(iris)

# View structure
str(iris)


# Normalize features (important!)
normalize <- function(x) {
  (x - min(x)) / (max(x) - min(x))
}

iris_norm <- as.data.frame(lapply(iris[,1:4], normalize))
iris_norm$Species <- iris$Species

##tRAIN AND TEST

set.seed(123)

index <- sample(1:nrow(iris_norm), 0.7*nrow(iris_norm))

train <- iris_norm[index, ]
test  <- iris_norm[-index, ]

#MODEL 
model <- nnet(
  Species ~ ., 
  data = train,
  size = 10,        # hidden neurons
  maxit = 200,      # iterations
  trace = FALSE
)

#size = 10 = number of neurons in the single hidden layer

##PREDICTIONS
pred <- predict(model, test, type = "class")

#eVALUATE
# Confusion matrix
table(Predicted = pred, Actual = test$Species)

# Accuracy
accuracy <- mean(pred == test$Species)
accuracy

###iMPORTANT LIMITATION
