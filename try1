#OpenAI Embedding Function
get_embedding <- function(text) {
  res <- POST(
    "https://api.openai.com/v1/embeddings",
    add_headers(
      Authorization = paste("Bearer", api_key),
      "Content-Type" = "application/json"
    ),
    body = toJSON(list(
      input = text,
      model = "text-embedding-3-small"
    ), auto_unbox = TRUE)
  )
  
  content(res)$data[[1]]$embedding
}

#Precompute Document Embeddings
docs$embedding <- lapply(docs$text, get_embedding)

#Cosine Similarity
cosine <- function(a, b) {
  sum(a * b) / (sqrt(sum(a * a)) * sqrt(sum(b * b)))
}

#Retrieval Function (RAG Step)
retrieve <- function(query, docs, top_k = 2) {
  
  q_emb <- get_embedding(query)
  
  scores <- sapply(docs$embedding, function(x) cosine(q_emb, x))
  
  top_idx <- order(scores, decreasing = TRUE)[1:top_k]
  
  docs[top_idx, ]
}

#GPT Answer Function (Generation Step)
generate_answer <- function(question, context_docs) {
  
  context <- paste(context_docs$text, collapse = "\n")
  
  prompt <- paste0(
    "Use the context to answer the question.\n\n",
    "Context:\n", context, "\n\n",
    "Question: ", question, "\n",
    "Answer:"
  )
  
  res <- POST(
    "https://api.openai.com/v1/chat/completions",
    add_headers(
      Authorization = paste("Bearer", api_key),
      "Content-Type" = "application/json"
    ),
    body = toJSON(list(
      model = "gpt-4o-mini",
      messages = list(
        list(role = "user", content = prompt)
      ),
      temperature = 0.2
    ), auto_unbox = TRUE)
  )
  
  content(res)$choices[[1]]$message$content
}

#sHINY UI
ui <- fluidPage(
  titlePanel("RAG Chatbot (R + OpenAI)"),

  sidebarLayout(
    sidebarPanel(
      textInput("question", "Ask a question:", ""),
      actionButton("ask", "Ask")
    ),

    mainPanel(
      h4("Answer"),
      verbatimTextOutput("answer"),

      h4("Retrieved Context"),
      verbatimTextOutput("context")
    )
  )
)

#Server Logic (RAG Pipeline)
server <- function(input, output, session) {

  result <- eventReactive(input$ask, {

    req(input$question)

    # Step 1: Retrieve relevant docs
    retrieved <- retrieve(input$question, docs, top_k = 2)

    # Step 2: Generate answer using GPT
    answer <- generate_answer(input$question, retrieved)

    list(
      answer = answer,
      context = paste(retrieved$text, collapse = "\n")
    )
  })

  output$answer <- renderText({
    req(result())
    result()$answer
  })

  output$context <- renderText({
    req(result())
    result()$context
  })
}

#Run the App
shinyApp(ui, server)


