#Step 2: Chatbot code
chat_with_llm <- function(user_text) {

  response <- POST(
    url = "https://api.openai.com/v1/chat/completions",
    add_headers(
      Authorization = paste("Bearer", api_key),
      "Content-Type" = "application/json"
    ),
    body = toJSON(list(
      model = "gpt-4o-mini",
      messages = list(
        list(role = "system", content = "You are a helpful R chatbot."),
        list(role = "user", content = user_text)
      )
    ), auto_unbox = TRUE)
  )

  result <- content(response, as = "parsed", type = "application/json")
  return(result$choices[[1]]$message$content)
}

#Step 3: Run chatbot loop
cat("R LLM Chatbot started (type 'exit' to stop)\n")

repeat {
  user_input <- readline("You: ")

  if (tolower(user_input) == "exit") {
    cat("Bot: Goodbye!\n")
    break
  }

  bot_reply <- chat_with_llm(user_input)
  cat("Bot:", bot_reply, "\n")
}


